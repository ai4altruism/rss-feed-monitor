# .env file for RSS Feed Monitor

# OpenAI API settings
#RSS Feed Monitor API key
OPENAI_API_KEY=sk-proj-

FILTER_MODEL=gpt-6-luna
GROUP_MODEL=gpt-5-mini
SUMMARIZE_MODEL=gpt-6-luna

# Filter prompt for LLM (plain language)
#FILTER_PROMPT="Only include stories related to Ukraine."
# Scored 2026-10-18 on 438 labeled articles with gpt-6-luna: recall about 72%
# (3 runs), against 53% for the previous wording, at similar precision.
FILTER_PROMPT="Include only reports of a SIGNIFICANT natural disaster that is happening now, struck within the last few days, or is forecast to strike within days, and that affects many people or a wide area: major earthquakes, tsunamis, hurricanes, typhoons and cyclones, severe flooding, major wildfires, volcanic eruptions, tornado outbreaks, landslides, and other severe weather. Signs of significance include deaths or injuries, evacuations, destroyed homes, or widespread power loss. EXCLUDE: transportation accidents, building collapses, industrial fires and explosions, crime, politics, routine weather, and small incidents. Also EXCLUDE stories that are not reports of a current event: preparedness drills and exercises, readiness or risk assessments, warning-system news, anniversaries and retrospectives, historical or prehistoric events, scientific research, opinion, and volunteer or fundraising stories. The story must name or clearly imply where the disaster is; a location in the headline is enough."

# RSS feed URLs (comma-separated)
RSS_FEEDS=

# Processing interval (in minutes)
PROCESS_INTERVAL=90

# Slack Integration
## Aid Arena 
SLACK_WEBHOOK_URL=

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
EMAIL_RECIPIENTS=

# Web Dashboard Settings
WEB_DASHBOARD_PORT=5001

# Article history settings
HISTORY_RETENTION_DAYS=14
